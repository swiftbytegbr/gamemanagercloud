# GMC_API_BASE_URL (backend without protocol, e.g. gmc.example.com/api) is set from the build argument
# VITE_API_BASE_URL, see Dockerfile. The trailing slash allows all paths below it.
:80 {
    root * /srv
    encode zstd gzip
    header {
               X-Content-Type-Options "nosniff"
               X-Frame-Options "DENY"
               Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
               Referrer-Policy "strict-origin-when-cross-origin"
               Cross-Origin-Opener-Policy "same-origin"
               Cross-Origin-Resource-Policy "cross-origin"
               # Relaxed to avoid blocking cross-origin resources needed by password manager
               # Cross-Origin-Embedder-Policy "credentialless"
               Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; script-src-elem 'self' 'unsafe-inline'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline' data: blob: https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' data: blob: https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://{$GMC_API_BASE_URL}/ wss://{$GMC_API_BASE_URL}/; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests;"
               Cache-Control "no-store"
           }
    @immutable {
                   path *.js *.mjs *.css *.svg *.woff *.woff2
               }
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    try_files {path} /index.html
    file_server
}
